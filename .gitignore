########################################
# livecraft: privacy + clean repo
# структуру livecraft (CLAUDE.md §5): secrets\, image\, bcast\, tokens\, keystreams\, state\, logs\.
# Широкие правила вида *.bat или *.ico не заводить — они прячут нужные файлы проекта.
########################################

########################################
# Environment files
########################################
.env
.env.*

########################################
# Секреты и настройки: всё, что в secrets\, — личное (CLAUDE.md §5, §7).
# livecraft.json в git тоже нет: в нём ссылка на форму и другие настройки человека
# (§14 решения 15, 16). Поставочный вид — app\resources\text\settings_shipped.json;
# нет файла — программа кладёт его сама (app\config\files.py::ShippedSettings).
# Явные строки ниже избыточны при /secrets/*, но оставлены как документ намерения:
#   livecraft.json       — технические настройки и ссылка на форму ключей
#   vault.local.dat      — личный сейф пользователя (DPAPI, привязан к Windows-аккаунту)
#   vault.token.dat      — значения из загруженного токена доступа (DPAPI)
#   channels.json        — каналы владельца; channels.previous.json, channels_passport.json
#   livecraft.sqlite3    — память программы (что сделано на YouTube и что подтвердила форма)
#   client_secret.json, <handle>.token.json, sheets.token.json, cookies.txt
########################################
/secrets/*
/secrets/livecraft.json
/secrets/vault.local.dat
/secrets/livecraft.sqlite3
/secrets/livecraft.sqlite3.broken-*
/secrets/cookies.txt

########################################
# Архивы в корне репо (например, app.zip для разбора: app, logs, bcast) — не в git:
# в них логи и пакеты, а репозиторий публичный.
########################################
/*.zip

########################################
# Google OAuth / API
########################################
credentials*.json
credentials_bot.json
.credentials_bot.json
client_secret*.json
*oauth*.json
*service_account*.json
*service-account*.json
*token.json

########################################
# Keys / certs
########################################
*.pem
*.key
*.p12

########################################
# Local helper materials
########################################
_HELP/

########################################
# Python / caches
########################################
__pycache__/
*.py[cod]
*.pyd
*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
pip-wheel-metadata/
*.egg-info/
.eggs/
# PyInstaller / Inno Setup: build\, dist\livecraft, dist\installer
# (build_local.bat / build_release.bat)
/build/
/dist/

.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

########################################
# Virtual environments
########################################
.venv/
venv/
ENV/
.venv_*/
.venv-*/
.poetry/

########################################
# Данные запуска, логи, временное.
# Пути привязаны к корню репо: app\output\, app\tools\ и app\texts\ —
# это пакеты с исходниками, их прятать нельзя.
########################################
*.log
/logs/
tmp/
temp/
/out/
/output/
/outputs/
/data/
/docs/
/downloads/
# превью источников: image\{date}\{language}
/image/
# ключи потоков для ручной передачи стримеру
/keystreams/
# файл-замок одного экземпляра и отметки автообновлений
/state/
# внешние бинарники: yt-dlp.exe, deno.exe (обновляются сами)
/tools/
# пакеты plan_*.bcast: пишет режим А, читает режим Б (§5, §14 решения 13, 18)
/bcast/
# созданные пары «токен + ключ» *.lctoken / *.lckey (§5, §14 решение 16)
/tokens/

########################################
# Локальные пусковые скрипты с абсолютными путями
########################################
*.local.bat
run_local*.bat

########################################
# IDE / OS / local workspace stuff
########################################
.vscode/
*.code-workspace

Thumbs.db
Desktop.ini
.DS_Store

########################################
# Claude Code local session state
########################################
.claude/
