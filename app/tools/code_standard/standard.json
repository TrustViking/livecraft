    {"level": "5", "packages": ["packages"], "imports": ["0", "1", "2", "3", "4"]},
    {"level": "6A", "packages": ["texts", "sheets", "sources", "llm", "intake"], "imports": ["0", "1", "2", "3", "4", "5"]},
    {"level": "6B", "packages": ["platforms", "form", "records", "pipeline", "output"], "imports": ["0", "1", "2", "3", "4", "5"]},
    {"level": "7", "packages": ["setup", "main", "tools"], "imports": ["0", "1", "2", "3", "4", "5", "6A", "6B", "7"]}
